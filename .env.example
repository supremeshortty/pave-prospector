# Copy to .env (git ignores it) and fill in what you have. Everything is optional except
# PROSPECTOR_CONTACT, which the SEC asks every automated client to send.

PROSPECTOR_CONTACT=you@example.com
PROSPECTOR_SENDER="Your Name, Pave"

# Free: 100 searches/day. Finds public LinkedIn profile URLs through Google (LinkedIn itself is never fetched).
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Email lookups. Used only after the company's own website, in this order: Apollo, Hunter, Exa.
# A pattern guess (clearly labeled) is the last resort when none of them find an address.
APOLLO_API_KEY=
HUNTER_API_KEY=
EXA_API_KEY=

# Caps per run so one run can't spend a month of free credits.
APOLLO_MAX_CALLS=10
HUNTER_MAX_CALLS=10
EXA_MAX_CALLS=20
